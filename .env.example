# Copia este archivo a .env y completa los valores. El archivo .env no se sube a git.

# Puerto donde escucha la API
API_PORT=8010

# ZEUS (MySQL)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=zeusdb

# BTL (Oracle)
ORACLE_BTL_HOST=
ORACLE_BTL_PORT=1531
ORACLE_BTL_SERVICE=
ORACLE_BTL_USER=
ORACLE_BTL_PASSWORD=

# Ingenieria (SQL Server)
SQLSERVER_HOST=
SQLSERVER_DATABASE=IngenieriaBD
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# Google Cloud (ruta al JSON de la cuenta de servicio)
GCP_CREDENTIALS_PATH=

# Logimas (APIs de Zeus)
LOGIMAS_AUTH_USER=
LOGIMAS_AUTH_TOKEN=
LOGIMAS_GUIA_USER=
LOGIMAS_BEARER_TOKEN=
LOGIMAS_BEARER_ANULACION=

# Webhook Corp Logistics
CORP_WEBHOOK_BEARER=

# Broker MQTT
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883

# Bot pickup (rutas de archivos que monitorea)
PICKUP_DATA_DIR=
PICKUP_REPORTE_INGRESO_DIR=
PICKUP_ARCHIVO_REPROGRAMACIONES=
PICKUP_ARCHIVO_COORDENADAS=
